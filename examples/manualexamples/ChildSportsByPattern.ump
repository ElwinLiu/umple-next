/* Example of using builtin Umple
 * Player Role pattern
*/

use lib:PlayerRole.ump;

class Person {
 isA Player;
 name;
}

class TeamRole {
  isA Role<Player=Person>;
}

class Athlete {
  isA TeamRole;
}

class Coach {
  isA TeamRole;
}

class ParentOfAthlete
{
  isA TeamRole;
  * -- * Athlete;
}


class SportsTeam {
  nickname;
  * -- * TeamRole;
}
