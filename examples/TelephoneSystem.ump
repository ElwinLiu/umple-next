//Namespace for core of the system.
namespace telesystem.core;

class PhoneCall{ 
 isOnHold;
 startTime;
 duration;
 * call -- 1 TelephoneNumber originator;
 * -- * TelephoneNumber parties;
}
class TelephoneNumber{
 digits;
 0..1 number -- * TelephoneNumber voicemail;
}
class VoiceMailBox{
 1 -- * VoiceMailMessage; 
 1 -- * TelephoneNumber;
}
class VoiceMailMessage {
 digitizedSound;
}
class Feature {
 description;
 * -- * TelephoneNumber;
}
class Telephone {
 model;
}
class PhoneLine {
 location;
 digOrAnalog;
 * -- * TelephoneNumber;
 1 -- 0..1 Telephone;
}
