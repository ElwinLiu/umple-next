// UML class diagram representing insurance claims

namespace insurance.core;

class Claim {
 String sequenceNumber;
 String sequenceNumber2;
 String description;
 String amountClaimed;
 1 -- 0..1 Clamor;
 key{sequenceNumber, sequenceNumber2}
}

class Clamor {
 String sequencia;
 String description="2";
 String plata;
 key{sequencia}
}
