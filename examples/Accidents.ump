// UML class diagram in Umple representing a system for
// reporting of accidents by an employer

namespace accidents;

class AccidentType
{
  code;
  description;
  key {code}
}

class SeriousnessLevel
{
  code;
  description;
  key {code}
}

class Employee
{
  id;
  department;
  name;
  supervisor;
  other_employee_details;
}

class Accident
{
  id;
  description;
  Date date;
  Time time;
  other_details;
  
  * -- 1 Employee;
  * -> 1 AccidentType;
  * -> 1 SeriousnessLevel;
  
  key {id}
}
